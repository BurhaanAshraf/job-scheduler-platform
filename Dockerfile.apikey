# One-shot API key provisioning image (ops tooling, not a service).
# Runs inside the compose network so no host ports or local Go toolchain
# are needed: docker compose --profile tools run --rm apikey ...
FROM golang:1.27-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ ./cmd/
COPY internal/ ./internal/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /apikey ./cmd/apikey

FROM scratch

COPY --from=builder /apikey /apikey

USER 65532

ENTRYPOINT ["/apikey"]
