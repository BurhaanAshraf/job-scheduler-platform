# Copy to .env and fill in secrets. Never commit .env.
# POSTGRES_PASSWORD is compose-only (used to build the Postgres container and
# the JOB_SCHEDULER_DB_DSN values below). It is NOT read by internal/config.Load().
POSTGRES_PASSWORD=change-me

# REDIS_PASSWORD is optional (empty = no auth) and IS read by
# internal/config.Load() as RedisPassword.
REDIS_PASSWORD=

# Primary connection strings (compose sets sane defaults).
# JOB_SCHEDULER_DB_DSN is preferred; legacy DB_DSN is accepted as a fallback
# (see internal/config/config.go firstNonEmpty). Set exactly one.
JOB_SCHEDULER_DB_DSN=postgres://burhaan:${POSTGRES_PASSWORD}@localhost:5432/job_scheduler?sslmode=disable
# Legacy fallback for JOB_SCHEDULER_DB_DSN (same format). Only used when
# JOB_SCHEDULER_DB_DSN is unset.
# DB_DSN=postgres://burhaan:${POSTGRES_PASSWORD}@localhost:5432/job_scheduler?sslmode=disable

# Redis server address
REDIS_ADDR=localhost:6379

# HTTP port used by the API server
API_PORT=4000

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Max connections in connection pool (per service; keep sum below Postgres max_connections)
DB_MAX_CONNS=10

# Scheduler polling interval. Default: 500ms.
# Lower values reduce dispatch latency but increase Redis polling;
# higher values reduce polling overhead but increase dispatch latency.
SCHEDULER_POLL_INTERVAL=500ms

# Scheduler identity for leader election logs. Empty default lets the binary
# fall back to hostname-uuid (unique per replica).
# SCHEDULER_INSTANCE_ID=scheduler-1

# Dev-only: allow webhook callbacks to private/internal addresses (e.g. the
# compose demo sink http://callback:8080/hook). Read by both the API
# (submit-time SSRF validation) and the worker (delivery-time validation),
# so both enforce the same rule. NEVER enable in production:
# the SSRF guard must stay strict there.
# JOB_SCHEDULER_ALLOW_PRIVATE_IPS=true
