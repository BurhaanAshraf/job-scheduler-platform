{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullImages",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PullProjectImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:aws:ecr:REGION:ACCOUNT_ID:repository/job-scheduler-api",
        "arn:aws:ecr:REGION:ACCOUNT_ID:repository/job-scheduler-scheduler",
        "arn:aws:ecr:REGION:ACCOUNT_ID:repository/job-scheduler-worker"
      ]
    },
    {
      "Sid": "ReadDbSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:job-scheduler/db-dsn*"
    },
    {
      "Sid": "WriteLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/ecs/job-scheduler-api:*",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/ecs/job-scheduler-scheduler:*",
        "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/ecs/job-scheduler-worker:*"
      ]
    }
  ]
}
